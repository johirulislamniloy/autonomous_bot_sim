<?xml version="1.0"?>
<robot name="autonomous_bot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ===== DIMENSIONS (meter) =====
       base_link = midpoint of the 2 drive wheels (axle). +X = forward.
       Total size: ~0.20 (L) x 0.20 (W) x 0.10 (H) -> fits 30x30x30 cm -->
  <xacro:property name="body_len" value="0.12"/>
  <xacro:property name="body_wid" value="0.10"/>
  <xacro:property name="body_h"   value="0.06"/>
  <xacro:property name="body_x"   value="0.03"/>   <!-- body centre ahead of axle -->
  <xacro:property name="body_z"   value="0.07"/>   <!-- body centre, bottom at 0.04 -->
  <xacro:property name="wheel_r"  value="0.035"/>
  <xacro:property name="wheel_w"  value="0.02"/>
  <xacro:property name="wheel_y"  value="0.06"/>   <!-- wheel centre, inner face touches body -->
  <xacro:property name="caster_r" value="0.02"/>
  <xacro:property name="caster_x" value="0.065"/>
  <xacro:property name="PI2"      value="1.5707963"/>

  <!-- ===== SERVO + TOF (replaces the old 5-sonar suite) =====
       One TOF on a servo head built on the body top, front centre.
       The servo sweeps left/right, so obstacle angles are KNOWN, not guessed. -->
  <xacro:property name="servo_x"    value="0.10"/>   <!-- joint (beam pivot) x -->
  <xacro:property name="servo_z"    value="0.045"/>  <!-- joint (beam pivot) z, beam height = 0.080 m abs -->
  <xacro:property name="servo_max"  value="1.4"/>    <!-- joint limit, rad (we sweep +-1.05) -->

  <!-- ===== CAMERA (raised mast, angled down: sees obstacle colours in the
       middle of the image AND the floor finish line in the bottom rows).
       Tilt must match CAM_TILT in the controller. -->
  <xacro:property name="cam_tilt" value="0.35"/>     <!-- rad down from horizontal -->
  <xacro:property name="cam_x"    value="0.075"/>
  <xacro:property name="cam_z"    value="0.15"/>     <!-- lens at 0.185 m above ground -->

  <!-- ===== 2 x ULTRASONIC SIDE SONARS =====
       One on each side of the body, beam pointing outwards with a 30 deg
       cone.  They keep the chassis from touching obstacles while the bot
       drives past them and while it sidesteps around a coloured obstacle. -->
  <xacro:property name="sonar_x"   value="0.06"/>
  <xacro:property name="sonar_y"   value="0.075"/>
  <xacro:property name="sonar_z"   value="0.055"/>
  <xacro:property name="sonar_half_cone" value="0.30"/>  <!-- rad: ~30 deg full
       cone, overlaps the front TOF sweep to close the near-side blind arc -->
  <!-- Physical ray length.  It MUST exceed the largest distance across either
       world (3x3 m ring diagonal ~4.24 m; 1x3 m arena diagonal ~3.16 m).
       libgazebo_ros_ray_sensor reports FLT_MAX when a ray hits nothing, and
       rclpy/Humble cannot deserialise a Range whose range is FLT_MAX.  With a
       length longer than the enclosed world every horizontal ray hits a wall,
       so a valid finite distance is always returned.  Values beyond the
       navigator's effective SONAR_MAX are clamped in the controller. -->
  <xacro:property name="ray_max" value="5.50"/>

  <!-- ===== 0. FOOTPRINT (ground) ===== -->
  <link name="base_footprint"/>
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- ===== 1. BASE (chassis) ===== -->
  <link name="base_link">
    <visual>
      <origin xyz="${body_x} 0 ${body_z}" rpy="0 0 0"/>
      <geometry><box size="${body_len} ${body_wid} ${body_h}"/></geometry>
      <material name="blue"><color rgba="0.0 0.0 0.8 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="${body_x} 0 ${body_z}" rpy="0 0 0"/>
      <geometry><box size="${body_len} ${body_wid} ${body_h}"/></geometry>
    </collision>
    <inertial>
      <origin xyz="${body_x} 0 ${body_z}" rpy="0 0 0"/>
      <mass value="1.2"/>
      <inertia ixx="0.00136" ixy="0.0" ixz="0.0" iyy="0.0018" iyz="0.0" izz="0.00244"/>
    </inertial>
  </link>

  <!-- ===== 2. DRIVE WHEELS (N20 motors, rear) ===== -->
  <xacro:macro name="drive_wheel" params="side y">
    <link name="${side}_wheel">
      <visual>
        <origin xyz="0 0 0" rpy="${PI2} 0 0"/>
        <geometry><cylinder radius="${wheel_r}" length="${wheel_w}"/></geometry>
        <material name="black"><color rgba="0.1 0.1 0.1 1.0"/></material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${PI2} 0 0"/>
        <geometry><cylinder radius="${wheel_r}" length="${wheel_w}"/></geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0" rpy="${PI2} 0 0"/>
        <mass value="0.05"/>
        <inertia ixx="0.000017" ixy="0.0" ixz="0.0" iyy="0.000017" iyz="0.0" izz="0.000031"/>
      </inertial>
    </link>
    <joint name="${side}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${side}_wheel"/>
      <origin xyz="0 ${y} ${wheel_r}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>

  <xacro:drive_wheel side="left"  y="${wheel_y}"/>
  <xacro:drive_wheel side="right" y="-${wheel_y}"/>

  <!-- ===== 3. FRONT CASTER (frictionless ball) ===== -->
  <link name="front_caster">
    <visual>
      <geometry><sphere radius="${caster_r}"/></geometry>
      <material name="grey"><color rgba="0.5 0.5 0.5 1.0"/></material>
    </visual>
    <collision>
      <geometry><sphere radius="${caster_r}"/></geometry>
    </collision>
    <inertial>
      <mass value="0.03"/>
      <inertia ixx="0.0000048" ixy="0.0" ixz="0.0" iyy="0.0000048" iyz="0.0" izz="0.0000048"/>
    </inertial>
  </link>
  <joint name="front_caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="front_caster"/>
    <origin xyz="${caster_x} 0.0 ${caster_r}" rpy="0 0 0"/>
  </joint>

  <!-- ===== 4. SERVO MOUNT (on the body top, front centre) ===== -->
  <link name="servo_mount_link">
    <visual>
      <origin xyz="0 0 -0.015"/>
      <geometry><box size="0.02 0.025 0.03"/></geometry>
      <material name="darkgrey"><color rgba="0.3 0.3 0.3 1.0"/></material>
    </visual>
    <inertial>
      <origin xyz="0 0 -0.015"/>
      <mass value="0.01"/>
      <inertia ixx="0.0000015" ixy="0.0" ixz="0.0" iyy="0.0000015" iyz="0.0" izz="0.0000015"/>
    </inertial>
  </link>
  <joint name="servo_mount_joint" type="fixed">
    <parent link="base_link"/>
    <child link="servo_mount_link"/>
    <origin xyz="0.088 0 ${servo_z + 0.01}" rpy="0 0 0"/>
  </joint>

  <!-- ===== 4b. SERVO HEAD + TOF SENSOR =====
       revolute joint (yaw): 0 = straight ahead, + = left (same as heading).
       The kinematic position is set by libgazebo_ros_joint_pose_trajectory
       (topic /set_joint_trajectory, trajectory_msgs/JointTrajectory). -->
  <link name="tof_link">
    <visual>
      <origin xyz="0.0075 0 0"/>
      <geometry><box size="0.015 0.025 0.02"/></geometry>
      <material name="teal"><color rgba="0.0 0.6 0.5 1.0"/></material>
    </visual>
    <inertial>
      <origin xyz="0.0075 0 0"/>
      <mass value="0.008"/>
      <inertia ixx="0.0000011" ixy="0.0" ixz="0.0" iyy="0.0000013" iyz="0.0" izz="0.0000022"/>
    </inertial>
  </link>
  <joint name="servo_joint" type="revolute">
    <parent link="base_link"/>
    <child link="tof_link"/>
    <origin xyz="${servo_x} 0 ${servo_z}" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-${servo_max}" upper="${servo_max}" effort="10" velocity="3.5"/>
  </joint>

  <gazebo reference="tof_link">
    <material>Gazebo/DarkGrey</material>
    <sensor type="ray" name="tof_sensor">
      <pose>0 0 0 0 0 0</pose>
      <visualize>true</visualize>
      <update_rate>25</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>1</samples>
            <resolution>1</resolution>
            <min_angle>0.0</min_angle>
            <max_angle>0.001</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.02</min>
          <max>${ray_max}</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.004</stddev>
        </noise>
      </ray>
      <plugin name="tof_plugin" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <namespace>/</namespace>
          <remapping>~/out:=tof_range</remapping>
        </ros>
        <output_type>sensor_msgs/Range</output_type>
        <radiation_type>infrared</radiation_type>
        <frame_name>tof_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <!-- servo head kinematic driver: single-point JointTrajectory msgs are
       published continuously by the controller; the joint keeps the last
       commanded position. header.frame_id = "world" (required). -->
  <gazebo>
    <plugin name="servo_pose_trajectory" filename="libgazebo_ros_joint_pose_trajectory.so">
      <update_rate>50</update_rate>
      <ros><namespace>/</namespace></ros>
    </plugin>
  </gazebo>

  <!-- ===== 5. FRONT CAMERA =====
       Raised on a short mast so its rays clear the servo head, tilted down:
       at 0.185 m height with 0.32 rad down-tilt it sees obstacles ahead
       (their faces) AND the floor from 0.19 m out to 0.55 m -> the 4 cm
       green finish strip is visible before the robot reaches it. -->
  <link name="front_camera_link">
    <visual>
      <origin xyz="0 0 -0.025"/>
      <geometry><box size="0.02 0.04 0.05"/></geometry>
      <material name="cam_black"><color rgba="0.05 0.05 0.05 1.0"/></material>
    </visual>
    <inertial>
      <origin xyz="0 0 -0.025"/>
      <mass value="0.005"/>
      <inertia ixx="0.000001" ixy="0.0" ixz="0.0" iyy="0.000001" iyz="0.0" izz="0.000001"/>
    </inertial>
  </link>

  <!-- fixed to base_link: mast standing on the body top -->
  <joint name="front_camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="front_camera_link"/>
    <origin xyz="${cam_x} 0 ${cam_z}" rpy="0 0 0"/>
  </joint>

  <gazebo reference="front_camera_link">
    <material>Gazebo/Black</material>
    <sensor type="camera" name="front_camera_sensor">
      <pose>0 0 0 0 ${cam_tilt} 0</pose>
      <always_on>true</always_on>
      <visualize>false</visualize>
      <update_rate>10</update_rate>
      <camera>
        <horizontal_fov>1.2</horizontal_fov>
        <image><width>320</width><height>240</height><format>R8G8B8</format></image>
        <clip><near>0.02</near><far>10.0</far></clip>
      </camera>
      <plugin name="front_camera_plugin" filename="libgazebo_ros_camera.so">
        <ros><namespace>/</namespace></ros>
        <camera_name>front_camera</camera_name>
        <frame_name>front_camera_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <!-- ===== 6. IMU (MPU6050-like) ===== -->
  <link name="imu_link">
    <inertial>
      <mass value="0.001"/>
      <inertia ixx="0.000001" ixy="0.0" ixz="0.0" iyy="0.000001" iyz="0.0" izz="0.000001"/>
    </inertial>
  </link>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0.07" rpy="0 0 0"/>
  </joint>

  <gazebo reference="imu_link">
    <sensor name="mpu6050" type="imu">
      <always_on>true</always_on>
      <update_rate>50</update_rate>
      <plugin name="imu_plugin" filename="libgazebo_ros_imu_sensor.so">
        <ros>
          <namespace>/</namespace>
          <remapping>~/out:=imu/data</remapping>
        </ros>
      </plugin>
    </sensor>
  </gazebo>

  <!-- ===== 6b. LEFT / RIGHT ULTRASONIC SONARS (simulated with ray sensors)
       Range messages: /sonar_left and /sonar_right.
       The reported range is the minimum of the 5 rays in the cone, which is
       exactly what an ultrasonic sensor does for a nearby flat object. -->
  <xacro:macro name="side_sonar" params="side y yaw">
    <link name="sonar_${side}_link">
      <visual>
        <geometry><box size="0.018 0.012 0.018"/></geometry>
        <material name="sonar_dark"><color rgba="0.15 0.15 0.15 1.0"/></material>
      </visual>
      <inertial>
        <mass value="0.003"/>
        <inertia ixx="0.0000002" ixy="0.0" ixz="0.0"
                 iyy="0.0000002" iyz="0.0" izz="0.0000002"/>
      </inertial>
    </link>
    <joint name="sonar_${side}_joint" type="fixed">
      <parent link="base_link"/>
      <child link="sonar_${side}_link"/>
      <origin xyz="${sonar_x} ${y} ${sonar_z}" rpy="0 0 ${yaw}"/>
    </joint>

    <gazebo reference="sonar_${side}_link">
      <material>Gazebo/DarkGrey</material>
      <sensor type="ray" name="sonar_${side}_sensor">
        <pose>0 0 0 0 0 0</pose>
        <visualize>true</visualize>
        <update_rate>15</update_rate>
        <ray>
          <scan>
            <horizontal>
              <samples>5</samples>
              <resolution>1</resolution>
              <min_angle>-${sonar_half_cone}</min_angle>
              <max_angle>${sonar_half_cone}</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.02</min>
            <max>${ray_max}</max>
            <resolution>0.01</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.008</stddev>
          </noise>
        </ray>
        <plugin name="sonar_${side}_plugin" filename="libgazebo_ros_ray_sensor.so">
          <ros>
            <namespace>/</namespace>
            <remapping>~/out:=sonar_${side}</remapping>
          </ros>
          <output_type>sensor_msgs/Range</output_type>
          <radiation_type>ultrasound</radiation_type>
          <frame_name>sonar_${side}_link</frame_name>
        </plugin>
      </sensor>
    </gazebo>
  </xacro:macro>

  <xacro:side_sonar side="left"  y="${sonar_y}"  yaw="${PI2}"/>
  <xacro:side_sonar side="right" y="${-sonar_y}" yaw="${-PI2}"/>


  <!-- ===== 7. GAZEBO DIFF DRIVE (encoder odometry) ===== -->
  <gazebo>
    <plugin name="diff_drive_controller" filename="libgazebo_ros_diff_drive.so">
      <update_rate>50</update_rate>
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>${2*wheel_y}</wheel_separation>
      <wheel_diameter>${2*wheel_r}</wheel_diameter>
      <max_wheel_torque>5</max_wheel_torque>
      <max_wheel_acceleration>8.0</max_wheel_acceleration>
      <command_topic>cmd_vel</command_topic>
      <odometry_topic>odom</odometry_topic>
      <odometry_source>0</odometry_source>  <!-- 0 = wheel encoders -->
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <publish_wheel_tf>false</publish_wheel_tf>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
    </plugin>

    <!-- wheel + servo joint states -> robot_state_publisher moves them in RViz -->
    <plugin name="joint_state_publisher" filename="libgazebo_ros_joint_state_publisher.so">
      <ros><remapping>~/out:=joint_states</remapping></ros>
      <update_rate>30</update_rate>
      <joint_name>left_wheel_joint</joint_name>
      <joint_name>right_wheel_joint</joint_name>
      <joint_name>servo_joint</joint_name>
    </plugin>
  </gazebo>

  <!-- ===== GAZEBO COLORS + FRICTION ===== -->
  <gazebo reference="base_link">
    <material>Gazebo/Blue</material>
  </gazebo>
  <gazebo reference="servo_mount_link">
    <material>Gazebo/Grey</material>
  </gazebo>
  <gazebo reference="left_wheel">
    <material>Gazebo/Black</material>
    <mu1>1.0</mu1><mu2>1.0</mu2>
  </gazebo>
  <gazebo reference="right_wheel">
    <material>Gazebo/Black</material>
    <mu1>1.0</mu1><mu2>1.0</mu2>
  </gazebo>
  <gazebo reference="front_caster">
    <material>Gazebo/Grey</material>
    <mu1>0.0</mu1><mu2>0.0</mu2>   <!-- caster must slide freely -->
  </gazebo>

</robot>
