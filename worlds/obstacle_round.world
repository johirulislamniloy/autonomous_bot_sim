<?xml version="1.0"?>
<sdf version="1.6">
  <world name="autonomous_arena_world">

    <!-- ===== COMPETITION OBSTACLE ROUND =====
         1 m x 3 m interior, 10 cm tall boundary walls, finish line 30 cm
         before the end-wall inner face.  The navigator's WALL_P / WALL_SIDE
         constants match these interior faces. ===== -->

    <!-- ===== 1. LIGHTING & PHYSICS ===== -->
    <include><uri>model://sun</uri></include>
    <include><uri>model://ground_plane</uri></include>

    <!-- ROS 2 state interface: lets the launch file place the robot exactly
         on the start line and read its world pose (gz model is unreliable
         here).  Exposes /gazebo/set_entity_state and /gazebo/get_entity_state. -->
    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
      <ros>
        <namespace>/</namespace>
      </ros>
      <update_rate>30.0</update_rate>
    </plugin>

    <physics name="default_physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000.0</real_time_update_rate>
    </physics>

    <!-- camera: behind start line, looking along the arena (+Y) -->
    <gui>
      <camera name="user_camera">
        <pose>0 -3.4 2.4 0 0.6 1.5708</pose>
      </camera>
    </gui>

    <!-- ===== 2. ARENA: interior 1.0 m (X) x 3.0 m (Y), 10 cm tall walls ===== -->
    <model name="wall_north">
      <static>true</static>
      <pose>0.0 1.5 0.05 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.0 0.05 0.1</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>1.0 0.05 0.1</size></box></geometry>
          <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_south">
      <static>true</static>
      <pose>0.0 -1.5 0.05 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.0 0.05 0.1</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>1.0 0.05 0.1</size></box></geometry>
          <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_east">
      <static>true</static>
      <pose>0.5 0.0 0.05 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.05 3.0 0.1</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.05 3.0 0.1</size></box></geometry>
          <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_west">
      <static>true</static>
      <pose>-0.5 0.0 0.05 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.05 3.0 0.1</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.05 3.0 0.1</size></box></geometry>
          <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ===== 3. START LINE (yellow) & FINISH LINE (red) - visual only =====
         End-wall inner face is y=+1.475, so the finish line sits 30 cm
         before it at y=+1.175.  The competition line is red and the boxes
         are red/green, so the camera distinguishes them by shape: the strip
         spans the image width in the floor band; a box is narrow and has
         red above that band. ===== -->
    <model name="start_line">
      <static>true</static>
      <pose>0.0 -1.35 0.001 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>0.95 0.04 0.002</size></box></geometry>
          <material><ambient>1 1 0 1</ambient><diffuse>1 1 0 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="finish_line">
      <static>true</static>
      <pose>0.0 1.175 0.001 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>0.95 0.04 0.002</size></box></geometry>
          <!-- same red as the red obstacles on purpose -->
          <material><ambient>0.85 0.08 0.08 1</ambient><diffuse>0.85 0.08 0.08 1</diffuse></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
